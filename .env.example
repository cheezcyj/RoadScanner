ROADSCANNER_EXPECTED_CLASS_MAP_SHA256=A5001A6CFAC4CF1C1135ABA53312226A59617FA635DF09B1C9B7B9F037A01F8E
ROADSCANNER_OOD_REFERENCE_PATH=ml_service/ood_reference.npz
