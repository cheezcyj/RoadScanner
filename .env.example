ROADSCANNER_OOD_SAFETY_MARGIN=0.07
ROADSCANNER_OOD_THRESHOLD_OVERRIDES=12:0.77
ROADSCANNER_DESIGN_PROTOTYPE_ENABLED=true
ROADSCANNER_DESIGN_PROTOTYPE_PATH=ml_service/design_prototypes.npz
ROADSCANNER_DESIGN_PROTOTYPE_METADATA_PATH=ml_service/design_prototypes.json
