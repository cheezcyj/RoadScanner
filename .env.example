ROADSCANNER_DESIGN_PROTOTYPE_RAW_MATCH_CLASSES=33
ROADSCANNER_ALLOWED_IMAGE_HOSTS=127.0.0.1,localhost,::1
ROADSCANNER_MAX_IMAGE_PIXELS=25000000
ROADSCANNER_MAX_IMAGE_DIMENSION=10000
ROADSCANNER_MIN_CONFIDENCE=0.85
ROADSCANNER_MIN_MARGIN=0.15
ROADSCANNER_MAX_CROP_ASPECT=1.45
ROADSCANNER_MIN_VISUAL_STD=0.01
ROADSCANNER_MIN_NEIGHBOR_CORRELATION=0.4
# "detect" analyzes whole scenes with the pinned ONNX detector. Use "crop"
# only when the caller already supplies a tightly cropped GTSRB-style sign.
ROADSCANNER_PIPELINE_MODE=detect
ROADSCANNER_DETECTOR_MODEL_PATH=traffic_sign_detector.onnx
ROADSCANNER_EXPECTED_DETECTOR_MODEL_SHA256=D1EC740200141D1BB6D96935ACC947216CFA28911A6D8F4F56F2832E7B30CF03
ROADSCANNER_DETECTOR_MIN_SCORE=0.7
ROADSCANNER_DETECTOR_NMS_IOU_THRESHOLD=0.45
ROADSCANNER_DETECTOR_MAX_CANDIDATES=10
ROADSCANNER_ALLOW_CROP_FALLBACK=true
ROADSCANNER_CROP_FALLBACK_MAX_ASPECT=1.25
ROADSCANNER_ML_HOST=127.0.0.1
ROADSCANNER_ML_PORT=5000
ROADSCANNER_LOGIN_MAX_FAILURES=5
ROADSCANNER_LOGIN_IP_MAX_FAILURES=25
ROADSCANNER_LOGIN_FAILURE_WINDOW_MS=600000
ROADSCANNER_LOGIN_LOCK_MS=900000
ROADSCANNER_LOGIN_MAX_TRACKED_KEYS=10000
# Comma-separated exact IPs of reverse proxies that sanitize/append X-Forwarded-For.
# Leave empty when clients connect directly; never put public client ranges here.
ROADSCANNER_TRUSTED_PROXIES=
ROADSCANNER_LOCAL_PASSWORD=
ROADSCANNER_DELETE_RETRY_BATCH_SIZE=25
ROADSCANNER_DELETE_RETRY_DELAY_MS=60000
